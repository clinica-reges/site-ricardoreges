# URL canônica do site (produção, apex — SEM www). Sem barra final.
NEXT_PUBLIC_SITE_URL=https://ricardoreges.com.br

# Base do agendamento online (booking DocFlow). Os parâmetros UTM
# são acrescentados por página pelo próprio site.
NEXT_PUBLIC_BOOKING_URL=https://docflow.med.br/dr-ricardo

# GA4 — Measurement ID. gtag carrega apenas em produção.
NEXT_PUBLIC_GA_ID=G-4DB4Z1Y232

# Validação dos eventos de conversão no DebugView do GA4: liga a tag fora de
# produção, marca os hits com debug_mode e loga cada evento no console.
# Use só localmente (npm run build && npm run serve). Nunca 'true' em produção.
# NEXT_PUBLIC_GA_DEBUG=true

# Perfis oficiais (Physician.sameAs no JSON-LD), ordem: Lattes · Scholar ·
# LinkedIn · Instagram · YouTube. Deixe vazio para omitir.
NEXT_PUBLIC_LATTES_URL=https://lattes.cnpq.br/4524635826900536
NEXT_PUBLIC_SCHOLAR_URL=https://scholar.google.com/citations?hl=pt-BR&user=s5ud4h8AAAAJ
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/regesricardo/
